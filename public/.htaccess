<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If file exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URL aliases
  RewriteRule ^projects/ongoing/?$ ongoing-projects.html [L]
  RewriteRule ^projects/completed/?$ completed-projects.html [L]
  RewriteRule ^projects/?$ completed-projects.html [L]
  RewriteRule ^strengths-services/?$ strengths-services.html [L]
  RewriteRule ^services/?$ strengths-services.html [L]
  RewriteRule ^about/?$ about.html [L]
  RewriteRule ^gallery/?$ gallery.html [L]
  RewriteRule ^contact/?$ contact.html [L]
  RewriteRule ^privacy/?$ privacy.html [L]
  RewriteRule ^terms/?$ terms.html [L]

  # Automatically resolve extensionless URLs to .html (e.g. /about -> /about.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>
